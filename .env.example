# ------------------------------------------------------------------
# Web Caravan - environment variables
# Copy this file to `.env.local` for local development and add the
# same keys in Vercel → Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# Public URL of the website (used for SEO, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Firebase (Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Secret address of the admin panel, e.g. ADMIN_PATH=my-secret-panel opens
# the panel at https://yoursite.com/my-secret-panel. Use letters, numbers and
# dashes only. /admin does not exist; without this value the panel is disabled.
ADMIN_PATH=

# Comma separated list of emails that can access the admin panel
# (must match the emails in firestore.rules)
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# Cloudinary (Cloudinary console → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder name for uploads
CLOUDINARY_FOLDER=webcaravan
