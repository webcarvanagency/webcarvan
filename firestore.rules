rules_version = '2';

// Keep this allowlist in sync with NEXT_PUBLIC_ADMIN_EMAILS.
// Publish in Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '').lower() in ['joker334747@gmail.com'];
    }

    // Website content: everyone can read, only admins can write
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ContactForm sends all seven fields, with Date.now() in milliseconds.
    function isValidMessage() {
      let data = request.resource.data;
      let fields = ['name', 'email', 'phone', 'service', 'message', 'createdAt', 'read'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*[^\\s].*')
        && data.email is string
        && data.email.size() > 0 && data.email.size() <= 150
        && data.email.matches('[^\\s@]+@[^\\s@]+\\.[^\\s@]+')
        && data.phone is string && data.phone.size() <= 30
        && data.service is string && data.service.size() <= 200
        && data.message is string
        && data.message.size() > 0 && data.message.size() <= 4000
        && data.message.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.createdAt is int && data.createdAt > 0
        && data.read == false;
    }

    // Visitors may submit enquiries but cannot read or change them.
    match /messages/{docId} {
      allow create: if isValidMessage();
      allow read, delete: if isAdmin();
      // The inbox only toggles read status; preserve the original enquiry.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    // New collections and nested paths require an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
